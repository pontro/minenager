# Minenager Cloud API Environment Configuration
PROJECT_NAME="Minenager Cloud API"
VERSION="1.0.0"
API_V1_STR="/api/v1"
ENVIRONMENT="development"  # set to "production" in live VPS

# PostgreSQL Database URL
DATABASE_URL="postgresql+asyncpg://minenager:minenager_dev_password@postgres:5432/minenager_cloud"

# JWT Security
JWT_SECRET="dev_jwt_secret_key_minenager_vps_32bytes_min!"
JWT_ALGORITHM="HS256"
JWT_EXPIRATION_MINUTES="43200"

# Admin Dashboard Protection
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="changeme_in_production!"

# Tunnel Relay Control
TUNNEL_RELAY_HOST="127.0.0.1"
TUNNEL_RELAY_CONTROL_PORT="2333"
TUNNEL_RELAY_TOKEN="minenager_tunnel_dev_secret_token_12345"

# Custom Domain & Cloudflare DNS (Optional in dev, required for zero-port SRV)
TUNNEL_DOMAIN="minenager.net"
CLOUDFLARE_API_TOKEN=""
CLOUDFLARE_ZONE_ID=""

# Stripe Payment & Subscriptions
STRIPE_PUBLISHABLE_KEY=""
STRIPE_SECRET_KEY=""
STRIPE_PRICE_ID="price_1UMwklRg74MeE2fvhbObV3Lm"
STRIPE_WEBHOOK_SECRET=""
DOMAIN="http://localhost:3000"
